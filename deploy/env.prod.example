# 生产环境变量模板：复制成 deploy/.env.prod 后按实际修改，不要提交到仓库。

# 运行环境（prod 会启用 application-prod.yml，缺少必填项会直接启动失败）
OA_PROFILE=prod
SERVER_PORT=4040

# 数据库
OA_DB_URL=jdbc:mysql://127.0.0.1:3306/oa_system?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
OA_DB_USERNAME=oa_app
OA_DB_PASSWORD=请改成真实密码

# JWT 密钥（必须换掉默认值，长度建议 32 位以上随机串）
OA_JWT_SECRET=请改成至少32位随机字符串
OA_JWT_EXPIRE_HOURS=24

# 上传目录（绝对路径，需可写；日志附件 20MB、通用附件 50MB）
OA_UPLOAD_DIR=/data/oa/uploads

# 允许跨域的前端来源，多个用逗号分隔。生产同域部署可以留空
OA_CORS_ORIGINS=https://oa.example.com

# 邮件（忘记密码验证码）
OA_MAIL_HOST=smtp.example.com
OA_MAIL_PORT=465
OA_MAIL_USERNAME=no-reply@example.com
OA_MAIL_PASSWORD=请改成真实密码

# 日志
OA_LOG_FILE=/data/oa/logs/oa-backend.log
